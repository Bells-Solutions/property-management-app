{
    "compilerOptions": {
        "target": "ES2016",
        "module": "CommonJS",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "typeRoots": ["./node_modules/@types", "./src/types"],
        "paths": {
            "@/*": ["./src"]
        }
    },
    "include": ["src/**/*", "eslint.config.mjs"],
    "exclude": ["node_modules"]
}
